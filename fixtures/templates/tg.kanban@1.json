{
  "spec": 1,
  "id": "tg.kanban",
  "version": 1,
  "summary": { "=": "'Kanban: ' + string(len(state.lanes)) + ' lanes'" },
  "root": {
    "type": "scroll_x",
    "gap": 8,
    "children": [
      {
        "type": "repeat",
        "each": { "=": "state.lanes" },
        "as": "lane",
        "key": { "=": "lane.title" },
        "child": {
          "type": "column",
          "width": 160,
          "gap": 6,
          "padding": 8,
          "background": "surface",
          "radius": 10,
          "children": [
            {
              "type": "row",
              "gap": 4,
              "align": "center",
              "children": [
                {
                  "type": "text",
                  "style": "caption",
                  "color": "text_secondary",
                  "text": { "=": "lane.title" }
                },
                {
                  "type": "text",
                  "style": "caption",
                  "color": "text_secondary",
                  "align": "end",
                  "tabular": true,
                  "width": 24,
                  "text": { "=": "string(len(lane.cards))" }
                }
              ]
            },
            {
              "type": "repeat",
              "each": { "=": "lane.cards" },
              "as": "card",
              "key": { "=": "card.id" },
              "child": {
                "type": "column",
                "padding": [6, 10, 6, 8],
                "background": "surface_alt",
                "radius": 8,
                "children": [
                  {
                    "type": "text",
                    "max_lines": 2,
                    "text": { "=": "card.title" }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
