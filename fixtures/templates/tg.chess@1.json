      {
        "type": "row",
        "gap": 8,
        "align": "center",
        "children": [
          {
            "type": "text",
            "style": "title",
            "text": { "=": "state.white + ' vs ' + state.black" }
          },
          {
            "type": "text",
            "style": "caption",
            "color": "text_secondary",
            "align": "end",
            "width": 110,
            "text": {
              "=": "state.turn == 'w' ? 'White to move' : 'Black to move'"
            }
          }
        ]
      },
      {
        "type": "canvas",
        "view_box": [8, 8],
        "radius": 8,
        "children": [
          {
            "type": "repeat",
            "each": { "=": "range(64)" },
            "as": "i",
            "child": {
              "type": "rect",
              "x": { "=": "i % 8" },
              "y": { "=": "floor(i / 8)" },
              "w": 1,
              "h": 1,
              "fill": {
                "=": "(i % 8 + floor(i / 8)) % 2 == 0 ? 'surface_alt' : 'accent@0.45'"
              }
            }
          },
          {
            "type": "repeat",
            "each": { "=": "state.last" },
            "as": "sq",
            "child": {
              "type": "rect",
              "x": { "=": "sq[0]" },
              "y": { "=": "sq[1]" },
              "w": 1,
              "h": 1,
              "fill": "warning@0.35"
            }
          },
          {
            "type": "repeat",
            "each": { "=": "state.pieces" },
            "as": "p",
            "key": { "=": "p.id" },
            "child": {
              "type": "use",
              "symbol": { "=": "p.kind" },
              "x": { "=": "p.x" },
              "y": { "=": "p.y" },
              "w": 1,
              "h": 1,
              "color": { "=": "p.side == 'w' ? '#FFFFFF' : '#3A3A3A'" }
            }
          }
        ]
      }
    ]
  }
